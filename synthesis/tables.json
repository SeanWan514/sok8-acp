  "eligibility_rules": [
    {
      "criterion": "Publication",
      "rule": "Individual papers, surveys, posters, demos, and extended abstracts; exclude whole proceedings or books."
    },
    {
      "criterion": "Date/language",
      "rule": "Identified version public by the cutoff; English or Chinese author abstract; no starting year."
    },
    {
      "criterion": "I1: transaction",
      "rule": "Software agent or implemented/simulated multi-agent system, commercial activity, and substantive study of its interaction or transaction mechanism."
    },
    {
      "criterion": "I2: protocol",
      "rule": "Identifiable agent protocol, substantive study of its mechanisms, and an explicit commercial connection."
    },
    {
      "criterion": "Commercial link",
      "rule": "The abstract establishes the link; A2A, AP2, and MCP may use the fixed ConvPayMAS association ."
    },
    {
      "criterion": "Out of scope",
      "rule": "Incidental agent/protocol mentions, generic applications, or economic actors without the software-agent or protocol connection required above."
    }
  ],
